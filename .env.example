DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXTAUTH_SECRET="isi-dengan-string-acak-panjang-dan-rahasia"
NEXTAUTH_URL="http://localhost:3000"
STITCH_API_KEY="isi-dengan-key-stitch-anda-jangan-commit"

# Konfigurasi SMTP untuk Email Transaksional (Lupa Password, dll)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="alamat-email-anda@gmail.com"
SMTP_PASSWORD="password-app-atau-smtp"
SMTP_FROM='"Prompt Gen" <noreply@promptgen.id>'


# Superadmin Seeding (used by prisma/seed.js - set before first run)
SUPERADMIN_EMAIL=superadmin@promptgen.com
SUPERADMIN_SEED_PASSWORD="ganti-dengan-password-kuat-min-12-karakter"

# Kunci rahasia untuk enkripsi API key pihak-ketiga (Gemini dll) milik user di database.
# WAJIB string acak minimal 32 karakter. JANGAN pernah diganti setelah production berjalan --
# mengganti nilai ini akan membuat SEMUA api key user yang tersimpan gagal di-dekripsi
# (user harus menambahkan ulang key mereka).
API_KEY_ENCRYPTION_SECRET="isi-dengan-string-acak-minimal-32-karakter-rahasia"

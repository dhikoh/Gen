generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  USER
}

enum PlanCode {
  STANDARD
  PRO
  ULTRA
  DEMO
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  EXPIRED
}

enum PaymentMethod {
  MANUAL_TRANSFER
  AUTOMATIC_GATEWAY
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  FAILED
}

enum RegistrationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum DraftType {
  VIDEO
  IMAGE
}

enum NotificationType {
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  SUBSCRIPTION_EXPIRING_SOON
  SUBSCRIPTION_EXPIRED
  CHANNEL_LOCKED
  CHANNEL_UNLOCKED
  NEW_PENDING_PAYMENT
  NEW_PENDING_REGISTRATION
  SYSTEM_ANNOUNCEMENT
  SUPPORT_TICKET_NEW
  SUPPORT_TICKET_REPLIED
  SUPPORT_TICKET_CLOSED
}

enum SupportTicketStatus {
  OPEN
  REPLIED
  CLOSED
}

enum CsMode {
  TICKET
  DIRECT_WHATSAPP
  DIRECT_EMAIL
}

enum NarrationMode {
  VOICE_OVER
  DIEGETIC_ONLY
  SILENT_TEXT_ONLY
  HYBRID
}

enum DurationCalcMode {
  NARRATION_WORDCOUNT
  SEGMENT_SELF_ESTIMATE
  HYBRID
}

model User {
  id                    String              @id @default(cuid())
  name                  String
  username              String              @unique
  email                 String              @unique
  phoneNumber           String?
  passwordHash          String
  dateOfBirth           DateTime?
  role                  Role                @default(USER)
  registrationStatus    RegistrationStatus  @default(APPROVED)
  approvedAt            DateTime?
  preferredLocale       String?             @default("id")
  hasUsedTrial          Boolean             @default(false)

  currentPlanId         String?
  currentPlan           Plan?               @relation(fields: [currentPlanId], references: [id])
  subscriptionStatus    SubscriptionStatus  @default(INACTIVE)
  subscriptionExpiresAt DateTime?

  generatorPreferences  Json?

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  channels              ProfileChannel[]
  invoices              Invoice[]
  drafts                Draft[]
  usedTitles            UsedTitle[]
  parsedOutputs         ParsedOutput[]
  resetTokens           PasswordResetToken[]
  notifications         Notification[]
  supportTickets        SupportTicket[]
}

model Plan {
  id                    String   @id @default(cuid())
  code                  PlanCode @unique
  name                  String
  priceMonthly          Int      // dalam Rupiah utuh, tanpa desimal
  currency              String   @default("IDR")
  maxChannels           Int
  features              Json?    // contoh: { "imagePromptStudio": true, "htmlBlogExport": true }
  isActive              Boolean  @default(true)
  isPubliclyPurchasable Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users                 User[]
  invoices              Invoice[]
}

model ProfileChannel {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelName     String
  niche           String?
  description     String?
  cta1            String?
  cta2            String?
  targetPlatform  String?
  personaPov      String?
  speechRate      Float?   @default(0.35)
  visualAesthetic String?
  audioBGM        Boolean  @default(true)
  audioSFX        Boolean  @default(true)
  audioVO         Boolean  @default(true)
  socialLinks     Json?
  usageCount      Int      @default(0) // statistik saja, TIDAK memengaruhi akses/kredit
  lastUsedAt      DateTime @default(now())
  isLocked        Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products        Product[]
  drafts          Draft[]
  usedTitles      UsedTitle[]
  contentArchetypeId String?
  contentArchetype   ContentArchetype? @relation(fields: [contentArchetypeId], references: [id], onDelete: SetNull)
}

model Product {
  id          String         @id @default(cuid())
  channelId   String
  channel     ProfileChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int
  link        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Invoice {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan          @relation(fields: [planId], references: [id])
  amount       Int
  currency     String        @default("IDR")
  method       PaymentMethod @default(MANUAL_TRANSFER)
  status       PaymentStatus @default(PENDING)
  proofUrl     String?       // khusus MANUAL_TRANSFER
  proofUploadedAt DateTime?
  rejectionReason String?    @db.Text
  externalRef  String?       // cadangan untuk gateway otomatis di masa depan
  periodDays   Int           @default(30)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Draft {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId            String?
  channel              ProfileChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  type                 DraftType
  title                String?
  rawJson              String    @db.Text
  parsedData           Json?
  targetDurationSec    Int?
  targetSceneCount     Int?
  narrativeLoopStyle   String?
  visualLoopStyle      String?
  wordCount            Int?
  estimatedDurationSec Int?
  durationSource       String?
  isTemplate           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AppSettings {
  id                          String   @id @default("singleton")
  bankName                    String?
  bankAccountNo               String?
  bankAccountName             String?
  heroTitle                   String?
  heroSubtitle                String?
  csMode                      CsMode   @default(TICKET)
  csWhatsappNumber            String?
  csEmail                     String?
  csOperatingHours            String?
  csWidgetEnabled             Boolean  @default(true)
  registrationPendingAlertHours Int?   @default(24)
  paymentPendingAlertHours      Int?   @default(12)
  rateLimitRequests           Int      @default(30)
  rateLimitWindowMs           Int      @default(60000)
  updatedAt                   DateTime @updatedAt
}

model PromptSettings {
  id                     String   @id @default("singleton")
  videoSystemInstruction String?  @db.Text
  imageSystemInstruction String?  @db.Text
  defaultSpeechRate      String?  @default("medium")
  defaultNegativePrompt  String?  @db.Text
  bannedWords            Json?
  updatedAt              DateTime @updatedAt
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             NotificationType
  title            String
  message          String           @db.Text
  link             String?
  isRead           Boolean          @default(false)
  // Fix 2.10: Groups all Notification rows created by one broadcast POST call.
  // Allows GET /api/admin/announcements to deduplicate: 1 row per broadcast, not 1 per recipient.
  broadcastGroupId String?
  createdAt        DateTime         @default(now())

  @@index([userId, isRead])
  @@index([broadcastGroupId])
}

model SupportTicket {
  id         String              @id @default(cuid())
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName  String?
  guestEmail String?
  subject    String
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  messages   SupportMessage[]

  @@index([status])
  @@index([userId])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole Role
  body       String        @db.Text
  createdAt  DateTime      @default(now())
}

model PlatformOption {
  id              String   @id @default(cuid())
  label           String   @unique
  isSystem        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
}

model PersonaPreset {
  id              String   @id @default(cuid())
  label           String
  description     String?
  isSystem        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
}

model VisualAestheticPreset {
  id              String   @id @default(cuid())
  label           String
  isSystem        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
}

model NicheCategoryPreset {
  id              String   @id @default(cuid())
  label           String
  isSystem        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
}

model ParsedOutput {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawInput     String   @db.Text
  parsedResult Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ── Used Titles Directory ──────────────────────────────────────────────────────
// Tabel permanen untuk menyimpan judul yang sudah dipakai.
// TERPISAH dari Draft — tidak ikut terhapus saat draft dihapus.
// AI membaca tabel ini untuk exclude list setiap kali generate.
model UsedTitle {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   ProfileChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  type      DraftType
  title     String
  createdAt DateTime  @default(now())

  @@unique([channelId, type, title])
  @@index([channelId, type])
  @@index([userId])
}

// ── Universal / Model-Agnostic Content Structure Engine (Bagian 23) ────────────
model ContentArchetype {
  id                      String           @id @default(cuid())
  name                    String           @unique
  description             String?
  narrationMode           NarrationMode    @default(VOICE_OVER)
  emotionalArcTemplate    String           @default("Hook -> Problem -> Solution -> CTA") @db.Text
  defaultIncludedSections Json             // { hook: boolean, cta: boolean, caption: boolean, thumbnail: boolean }
  compositionCategories   Json             // [ { label: string, required: boolean } ]
  durationCalcMode        DurationCalcMode @default(HYBRID)
  cameraMovementRoleMap   Json?            // override mapping peran -> camera movement
  isSystem                Boolean          @default(false)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  channels                ProfileChannel[]
}

